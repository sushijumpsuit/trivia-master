# Which LLM to use: anthropic | openai | groq | gemini
LLM_PROVIDER=groq

# Only the key for the provider you're using is required.
ANTHROPIC_API_KEY=sk-ant-your-key-here     # console.anthropic.com/settings/keys
OPENAI_API_KEY=sk-your-key-here            # platform.openai.com/api-keys
GROQ_API_KEY=gsk_your-key-here             # console.groq.com/keys (free tier)
GEMINI_API_KEY=your-key-here               # aistudio.google.com/apikey (free tier)

# Optional model overrides (defaults live in sanity_check.py / llm/)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=                              # required if LLM_PROVIDER=openai; see platform.openai.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash

FRONTEND_ORIGINS=http://localhost:3000
