# Which LLM to use: anthropic | openai | groq | gemini | deepseek
LLM_PROVIDER=groq

# Only the key for the provider you're using is required.
ANTHROPIC_API_KEY=sk-ant-your-key-here     # console.anthropic.com/settings/keys
OPENAI_API_KEY=sk-your-key-here            # platform.openai.com/api-keys
GROQ_API_KEY=gsk_your-key-here             # console.groq.com/keys (free tier)
GEMINI_API_KEY=your-key-here               # aistudio.google.com/apikey (free tier)
DEEPSEEK_API_KEY=sk-your-key-here          # platform.deepseek.com/api_keys (paid, very cheap)

# Optional model overrides (defaults live in sanity_check.py / llm/)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=                              # required if LLM_PROVIDER=openai; see platform.openai.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_MODEL=deepseek-flash              # or deepseek-v4-pro (stronger, ~4x the price)
DEEPSEEK_THINKING=enabled                  # reasoning mode: far fewer wrong questions, ~2s slower per turn

# Question memory (ChromaDB). Cutoffs picked with: python tune_threshold.py
CHROMA_PATH=chroma_data
DUP_SAME_ANSWER_DISTANCE=0.46   # same answer and closer than this = repeat
DUP_ANY_ANSWER_DISTANCE=0.05    # different answer: repeat only if closer than this

FRONTEND_ORIGINS=http://localhost:3000

# Public demo limits (0 = off). A 100-question game costs about $0.18 on DeepSeek Flash.
IP_GAMES_PER_HOUR=5          # games one visitor can start per hour
IP_QUESTIONS_PER_DAY=100     # questions one visitor can play per day
DAILY_QUESTION_LIMIT=300     # questions everyone together can play per day
